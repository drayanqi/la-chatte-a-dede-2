# La Chatte à Dédé - Production Environment Variables
# Copy this file to .env and fill in actual values
# IMPORTANT: Never commit the actual .env file to version control

# =============================================================================
# MySQL Database
# =============================================================================
# Generate passwords with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
DB_DATABASE=lachatadede
DB_USERNAME=lachatadede_user
DB_PASSWORD=your_secure_db_password_here

# =============================================================================
# Laravel Application
# =============================================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=http://venanciohugo.fr

# Generate with: php artisan key:generate --show
# Or the deploy script will generate it automatically
APP_KEY=

# =============================================================================
# Node.js Game Engine (Placeholder for Epic 3)
# =============================================================================
NODE_ENV=production
PORT=3001

# =============================================================================
# GitHub Secrets Reference
# =============================================================================
# The following values should be stored as GitHub Secrets, not in this file:
#
# VPS_HOST          - Your VPS IP address or hostname
# VPS_USER          - SSH username (pelo)
# VPS_SSH_KEY       - Private SSH key for deployment
# DB_PASSWORD       - Same as above
# DB_ROOT_PASSWORD  - Same as MYSQL_ROOT_PASSWORD above
# APP_KEY           - Laravel application key
