# Node.js Game Engine Dockerfile
# Build context: lachatadede-engine/
# Supports both development and production builds

FROM node:24-alpine AS base

WORKDIR /app

# Install build dependencies for native modules
# (isolated-vm in Story 3.4 needs python3, make, g++ at install time)
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# ============================================
# Development stage
# ============================================
FROM base AS development

# Install ALL dependencies (including devDependencies)
RUN npm ci

# Copy application code
COPY . .

EXPOSE 3001

# Development with hot reload
CMD ["npm", "run", "dev"]

# ============================================
# Build stage (TypeScript compilation)
# ============================================
FROM base AS build

RUN npm ci

COPY . .

RUN npm run build

# ============================================
# Production stage
# ============================================
FROM node:24-alpine AS production

WORKDIR /app

# Build dependencies kept for Story 3.4 (isolated-vm native install)
RUN apk add --no-cache python3 make g++

COPY package*.json ./

# Install production dependencies only (npm 7+ syntax)
RUN npm ci --omit=dev

# Compiled JavaScript from the build stage
COPY --from=build /app/dist ./dist

# Run as the non-root node user (uid 1000). The bind-mounted /app/storage
# must be writable by uid 1000 on the host (see deployment spec).
RUN chown -R node:node /app

USER node

EXPOSE 3001

# Production entry point
CMD ["node", "dist/index.js"]
