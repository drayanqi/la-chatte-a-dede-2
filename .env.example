# Lachatadede Test Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Test Environment
# ============================================
TEST_ENV=local

# Frontend (Vite dev server)
BASE_URL=http://localhost:5173

# Backend API (Laravel)
API_URL=http://localhost:8000/api

# ============================================
# Authentication (for seeded test users)
# ============================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPass123!

# Admin test user (if needed)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPass123!

# ============================================
# Game Engine
# ============================================
# Node.js simulation service
ENGINE_URL=http://localhost:3001

# ============================================
# CI Configuration
# ============================================
# Set to 'true' in CI environment
CI=false

# ============================================
# Debug
# ============================================
# Enable verbose test logging
DEBUG=false
