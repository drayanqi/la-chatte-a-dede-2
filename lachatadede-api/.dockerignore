# Laravel API Docker Ignore
# Exclude files not needed in production container

# Dependencies (installed during build)
vendor/

# Development files
.git/
.gitignore
.env
.env.example
.env.testing

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Testing
tests/
phpunit.xml
.phpunit.result.cache

# Documentation
README.md
docs/

# Build artifacts
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

# OS files
.DS_Store
Thumbs.db

# Laravel Sail (development only)
docker-compose.yml
